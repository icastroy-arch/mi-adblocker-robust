{
  "manifest_version": 3,
  "name": "AdSkipper Unificado & Robusto",
  "version": "2.0.0",
  "description": "Saltador de anuncios con actualización remota y local en caliente.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8765/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-v2.js"],
      "run_at": "document_idle"
    }
  ]
}